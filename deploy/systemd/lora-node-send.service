[Unit]
Description=BEAM LoRa Node Sender Task
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/BEAM_Prototype3
Environment=PYTHONPATH=/home/pi/BEAM_Prototype3/src
ExecStart=/usr/bin/python3 /home/pi/BEAM_Prototype3/src/beamnode/transport/lora/node_send.py
StandardOutput=append:/home/pi/logs/lora_node_daemon.log
StandardError=append:/home/pi/logs/lora_node_daemon.log
